# --- Server ---
PORT=8080
LOG_LEVEL=info
SERVER_NAME=mcp-toolkit

# --- MCP transport ---
# Comma-separated extra Host header values to accept. localhost / 127.0.0.1
# / [::1] (any port) are always allowed.
# Example: MCP_ALLOWED_HOSTS=mcp.example.com,mcp.staging.example.com
MCP_ALLOWED_HOSTS=

# --- Auth / quotas ---
# Choose store: "memory" for dev, "upstash" for prod.
TOKEN_STORE=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Dev-only escape hatch: skip the bearer-auth middleware entirely.
# DO NOT set in production.
MCPTK_AUTH_DISABLED=

# --- Observability ---
# Prometheus exposition endpoint. Default /metrics, served on the
# same port as the MCP HTTP transport. Set to empty to disable.
METRICS_PATH=/metrics
METRICS_ENABLED=1

# --- Multi-tenancy ---
# "single" = one tenant ("default"). "header" = X-Tenant-Id header.
# "subdomain" = first dotted segment of Host. "token" = tenant
# embedded in the bearer token's scope claims.
TENANT_STRATEGY=single

# --- OpenTelemetry (optional) ---
# Set to enable distributed tracing. Requires the [otel] extra.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Conversation identity (opt-in; docs/SPEC-conversation-metering.md) ---
# Off by default: middleware never mounted, zero overhead.
CONV_ENABLED=false
# Key waterfall order: _meta field, connection header, session blob.
CONV_KEY_SOURCES=meta,header,session
CONV_HEADER=X-Conversation-Key
# `_meta` field consulted on tools/call (waterfall source "meta").
CONV_META_KEY=ai.mcp-toolkit.conversation_key
CONV_END_USER_HEADER=X-End-User-Id
CONV_TTL_HEADER=X-Conversation-Ttl
# Conversation TTLs (seconds): default 1 day, ceiling 7 days.
CONV_TTL_DEFAULT=86400
CONV_TTL_MAX=604800
# Hard root age cap (seconds); beyond it = conversation_expired.
CONV_ROOT_MAX_AGE=604800
# Max parallel tools/call per conversation root.
CONV_INFLIGHT_MAX=16
# Base64 32-byte Ed25519 seed (SessionBlobSigner.generate_signing_key()).
# Empty = ephemeral per-process dev key; blobs won't verify across pods.
CONV_SIGNING_KEY=
CONV_SIGNING_KID=k1
# Previous key for rotation overlap. Verified, never signed with.
CONV_SIGNING_KEY_PREVIOUS=
CONV_SIGNING_KID_PREVIOUS=
# Mcp-Session-Id blob lifetime (seconds).
CONV_BLOB_TTL=3600
# Genesis events per tenant per hour. 0 = unlimited.
CONV_GENESIS_RATE_LIMIT=0
# "memory" for dev, "upstash" for prod (uses UPSTASH_REDIS_REST_* above).
CONV_STORE=memory
CONV_JWKS_PATH=/.well-known/mcp-toolkit-jwks.json

# --- Metering (opt-in; requires CONV_ENABLED) ---
METER_ENABLED=false
# "redis_stream" (durable primary) | "jsonl" (dev) | "stripe_meters".
METER_SINK=redis_stream
# Seconds a request-identity dedupe claim lives (transport retries bill once).
METER_DEDUPE_WINDOW=300
METER_STREAM_KEY=meter:events
METER_JSONL_PATH=meter-events.jsonl
# Rate table (.json in core, .yaml via [billing]). Empty = shadow mode.
METER_RATE_TABLE=

# --- Billing consumer (apps/billing, [billing] extra) ---
STRIPE_API_KEY=
STRIPE_METER_EVENT_NAME=mcp_units
